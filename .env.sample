# Omniverse Platform Environment Configuration
# Copy this file to .env and modify values for your deployment
# cp .env.sample .env

# ---- Deployment Settings ----
SERVER_IP=localhost              # Change this to update all frontend URLs (localhost / 192.168.x.x / domain.com)
FRONTEND_PORT=3001
BACKEND_PORT=8001
DB_PORT=5432

# ---- Django Configuration ----
DJANGO_SECRET_KEY=change-me-in-production  # Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=True                           # Development: True, Production: False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1   # Production: add your server IP/domain

# ---- Database Configuration ----
DB_HOST=postgres                 # Docker internal DNS, do not change
DB_NAME=ran_dt
DB_USER=ran
DB_PASSWORD=ran                  # Production: change to strong password

# ---- Kit Render Server Configuration ----
HTTP_KIT_HOST=kit               # Docker internal DNS, do not change
HTTP_KIT_PORT=8080
WS_KIT_PORT=8081

# ---- Backend Server Configuration ----
LOG_LEVEL=INFO                  # Development: DEBUG/INFO, Production: WARNING/ERROR
