# Stage 1: Base system with Xvfb, VNC, and dependencies
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# Metadata
LABEL maintainer="RAN Team"
LABEL description="Omniverse Kit with Xvfb, x11vnc, and noVNC"

# Environment variables
ENV DISPLAY=:99 \
    DISPLAY_SIZE="2560x1440" \
    DISPLAY_DEPTH="24" \
    VNC_PORT="5900" \
    VNC_WEB_PORT="6080" \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # X11 and virtual display
    xvfb \
    x11vnc \
    fluxbox \
    xterm \
    # VNC web interface
    git \
    python3 \
    python3-pip \
    # Networking and utilities
    wget \
    curl \
    net-tools \
    netcat \
    supervisor \
    # Runtime dependencies
    libssl3 \
    libxkbcommon-x11-0 \
    libxcb-xtest0 \
    libxcb-shape0 \
    libxcb-randr0 \
    libglib2.0-0 \
    libfontconfig1 \
    libfreetype6 \
    # Cleanup
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create directories
RUN mkdir -p /home/omniverse \
    /home/omniverse/.nvidia-omniverse \
    /tmp/logs \
    && chmod 777 /tmp/logs

# Clone and setup noVNC
RUN git clone --depth 1 https://github.com/novnc/noVNC.git /opt/noVNC

# Create supervisor configuration directory
RUN mkdir -p /etc/supervisor/conf.d

# Supervisor configuration file for managing processes
RUN cat > /etc/supervisor/supervisord.conf << 'EOF'
[supervisord]
nodaemon=true
logfile=/tmp/logs/supervisord.log
pidfile=/var/run/supervisord.pid

[unix_http_server]
file=/var/run/supervisor.sock

[supervisorctl]
serverurl=unix:///var/run/supervisor.sock

[rpcinterface:supervisor]
supervisor.rpc_interface_factory = supervisor.rpcinterface:make_main_rpcinterface

[include]
files = /etc/supervisor/conf.d/*.conf
EOF

# Xvfb configuration
RUN cat > /etc/supervisor/conf.d/xvfb.conf << 'EOF'
[program:xvfb]
command=/usr/bin/Xvfb %%(ENV_DISPLAY)s -screen 0 %%(ENV_DISPLAY_SIZE)sx%%(ENV_DISPLAY_DEPTH)s -ac -noreset +extension GLX
autorestart=true
autostart=true
stdout_logfile=/tmp/logs/xvfb.log
stderr_logfile=/tmp/logs/xvfb-error.log
priority=1
EOF

# Fluxbox configuration
RUN cat > /etc/supervisor/conf.d/fluxbox.conf << 'EOF'
[program:fluxbox]
command=/usr/bin/fluxbox
environment=DISPLAY=%%(ENV_DISPLAY)s
autorestart=true
autostart=true
stdout_logfile=/tmp/logs/fluxbox.log
stderr_logfile=/tmp/logs/fluxbox-error.log
priority=2
EOF

# x11vnc configuration
RUN cat > /etc/supervisor/conf.d/x11vnc.conf << 'EOF'
[program:x11vnc]
command=/usr/bin/x11vnc -display %%(ENV_DISPLAY)s -nopw -forever -shared -rfbport %%(ENV_VNC_PORT)s -noxrandr -xkb
environment=DISPLAY=%%(ENV_DISPLAY)s
autorestart=true
autostart=true
stdout_logfile=/tmp/logs/x11vnc.log
stderr_logfile=/tmp/logs/x11vnc-error.log
priority=3
EOF

# noVNC configuration
RUN cat > /etc/supervisor/conf.d/novnc.conf << 'EOF'
[program:novnc]
command=/opt/noVNC/utils/novnc_proxy --vnc localhost:%%(ENV_VNC_PORT)s --listen %%(ENV_VNC_WEB_PORT)s
autorestart=true
autostart=true
stdout_logfile=/tmp/logs/novnc.log
stderr_logfile=/tmp/logs/novnc-error.log
priority=4
EOF

# Setup user
RUN useradd -m -s /bin/bash omniverse && \
    usermod -aG sudo omniverse && \
    chown -R omniverse:omniverse /home/omniverse

WORKDIR /home/omniverse

# Copy startup script
COPY --chown=omniverse:omniverse kit-vnc-startup.sh /home/omniverse/startup.sh
RUN chmod +x /home/omniverse/startup.sh

# Expose ports
EXPOSE 5900 6080 8080 8001 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD nc -z localhost 5900 && nc -z localhost 6080 && echo "healthy" || exit 1

# Default command
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]
