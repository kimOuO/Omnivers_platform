@startuml UC-02_scene_build_clear
!pragma teoz true

title "UC-02  操作員建構 / 清空場景"

skinparam backgroundColor #ECFFFF
skinparam roundcorner 15
skinparam DefaultFontSize 14
skinparam DefaultFontName Arial
hide footbox
skinparam sequenceMessageAlign center

actor Operator as "Operator"

box "omniver_platform [Platform]" #LightYellow
    box "ran_dt [System]\n\n" #LightBlue
        box "frontend_view [Module]\n\n" #LightGreen
            participant SceneControls as "SceneControls\n[Component]"
        end box
        box "backend_scene [Module]\n\n" #LightGreen
            participant SceneController as "SceneController\n[Actor]"
        end box
    end box
end box

participant KitRenderServer as "kit_render_server\n[External]"

activate Operator

group SceneController.build [建構場景]
    autonumber 1.1
    Operator -> SceneControls : 點 [Build Scene]
    activate SceneControls

    autonumber 1.2
    SceneControls -> SceneController : POST /RAN/Scene/SceneController/build
    activate SceneController

    autonumber 1.3
    SceneController -> KitRenderServer : POST /scene/build
    activate KitRenderServer
    KitRenderServer -> KitRenderServer : enqueue "build_scene" cmd
    KitRenderServer --> SceneController : {status:"queued"}
    deactivate KitRenderServer

    autonumber 1.4
    SceneController --> SceneControls : {success, message:"queued", data:{action:"build"}}
    deactivate SceneController

    autonumber 1.5
    note over KitRenderServer
        Kit update loop 於下一幀執行 queue：
         • 讀 scene_config.json
         • 建立 /World/Ground、/World/<Building_*>
         • 建立 /World/<gNB_*>、/World/<UE_*>
         • 註冊 UE 動畫 waypoints
         • VNC 視窗即時顯示
    end note
end group

group SceneController.clear [清空場景]
    autonumber 2.1
    Operator -> SceneControls : 點 [Clear Scene]

    autonumber 2.2
    SceneControls -> SceneController : POST /RAN/Scene/SceneController/clear
    activate SceneController
    SceneController -> KitRenderServer : POST /scene/clear
    KitRenderServer --> SceneController : {status:"queued"}
    SceneController --> SceneControls : {success, message:"queued"}
    deactivate SceneController
end group

deactivate SceneControls
deactivate Operator

@enduml
