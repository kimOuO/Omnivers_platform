@startuml UC-03_animation_control
!pragma teoz true

title "UC-03  操作員控制 UE 動畫"

skinparam backgroundColor #ECFFFF
skinparam roundcorner 15
skinparam DefaultFontSize 14
skinparam DefaultFontName Arial
hide footbox
skinparam sequenceMessageAlign center

actor Operator as "Operator"

box "omniver_platform [Platform]" #LightYellow
    box "ran_dt [System]\n\n" #LightBlue
        box "frontend_view [Module]\n\n" #LightGreen
            participant SceneControls as "SceneControls\n[Component]"
        end box
        box "backend_scene [Module]\n\n" #LightGreen
            participant AnimationController as "AnimationController\n[Actor]"
        end box
    end box
end box

participant KitRenderServer as "kit_render_server\n[External]"

activate Operator

group AnimationController.start
    autonumber 1.1
    Operator -> SceneControls : 點 [▶ Start Animation]
    activate SceneControls

    autonumber 1.2
    SceneControls -> AnimationController : POST /RAN/Scene/AnimationController/start
    activate AnimationController

    autonumber 1.3
    AnimationController -> KitRenderServer : POST /animation/start
    activate KitRenderServer
    KitRenderServer -> KitRenderServer : 訂閱 update_event_stream\n每幀沿 waypoints 更新 UE translate
    KitRenderServer --> AnimationController : {status:"queued"}
    deactivate KitRenderServer

    autonumber 1.4
    AnimationController --> SceneControls : {success, message:"queued"}
    deactivate AnimationController
end group

group AnimationController.stop
    autonumber 2.1
    Operator -> SceneControls : 點 [■ Stop Animation]

    autonumber 2.2
    SceneControls -> AnimationController : POST /RAN/Scene/AnimationController/stop
    activate AnimationController
    AnimationController -> KitRenderServer : POST /animation/stop
    KitRenderServer -> KitRenderServer : 取消 update_event_stream 訂閱
    KitRenderServer --> AnimationController : {status:"queued"}
    AnimationController --> SceneControls : {success, message:"queued"}
    deactivate AnimationController
end group

deactivate SceneControls
deactivate Operator

@enduml
