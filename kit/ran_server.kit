# RAN Omniverse Server (S1: pip omniverse-kit, no repo.sh build needed)
# Based on kit-app-template/source/apps/ran.scene.editor.kit, with:
#   - mitlab.ran.signal removed (signals are ingested externally)
#   - folders point to Omniver_platform/extensions + legacy extscache (symlink)
#
# Launch:
#   source ~/omniverse-env/bin/activate
#   /home/mitlab/Omniverse/Omniverse/Omniver_platform/kit/run.sh

[package]
title = "RAN Omniverse Server"
version = "0.2.0"
description = "Long-running Kit render server for the RAN digital twin."
keywords = ["app"]
template_name = "kit_base_editor"


[dependencies]
"omni.activity.profiler" = {}
"omni.activity.pump" = {}
"omni.anim.curve.core" = {}
"omni.graph.action" = {}
"omni.graph.core" = {}
"omni.graph.nodes" = {}
"omni.graph.scriptnode" = {}
"omni.graph.ui_nodes" = {}
"omni.hydra.engine.stats" = {}
"omni.hydra.rtx" = {}
"omni.hydra.pxr" = {}
"omni.hydra.usdrt_delegate" = {}
"omni.kit.developer.bundle" = {}
"omni.kit.mainwindow" = {}
"omni.kit.manipulator.camera" = {}
"omni.kit.manipulator.prim" = {}
"omni.kit.manipulator.selection" = {}
"omni.kit.material.library" = {}
"omni.kit.menu.common" = { order = 1000 }
"omni.kit.menu.create" = {}
"omni.kit.menu.edit" = {}
"omni.kit.menu.file" = {}
"omni.kit.primitive.mesh" = {}
"omni.kit.property.bundle" = {}
"omni.kit.raycast.query" = {}
"omni.kit.stage_template.core" = {}
"omni.kit.telemetry" = {}
"omni.kit.tool.asset_importer" = {}
"omni.kit.tool.collect" = {}
"omni.kit.viewport.legacy_gizmos" = {}
"omni.kit.viewport.menubar.camera" = {}
"omni.kit.viewport.menubar.display" = {}
"omni.kit.viewport.menubar.lighting" = {}
"omni.kit.viewport.menubar.render" = {}
"omni.kit.viewport.menubar.settings" = {}
"omni.kit.viewport.ready" = {}
"omni.kit.viewport.scene_camera_model" = {}
"omni.kit.viewport.window" = {}
"omni.kit.widget.cache_indicator" = {}
"omni.kit.window.console" = {}
"omni.kit.window.content_browser" = {}
"omni.kit.window.property" = {}
"omni.kit.window.stage" = {}
"omni.kit.window.status_bar" = {}
"omni.kit.window.toolbar" = {}
"omni.physx.stageupdate" = {}
"omni.rtx.settings.core" = {}
"omni.uiaudio" = {}
"omni.ui.scene" = {}                       # for mitlab.ran.labels (S5)
"omni.usd.metrics.assembler.ui" = {}
"omni.usd.schema.metrics.assembler" = {}
"omni.warp.core" = {}
# --- our extensions ---
"mitlab.ran.scene.builder" = {}
"mitlab.ran.api" = {}
"mitlab.ran.labels" = {}                   # S5: UE overhead billboards (改用 sc.Label)
# mitlab.ran.signal removed — signals ingested via backend


[settings.persistent.app]
viewport.autoFrame.mode = "first_open"


[settings]
crashreporter.compressDumpFiles = true
exts."omni.kit.material.library".ui_show_list = ["OmniPBR", "OmniGlass", "OmniSurface", "USD Preview Surface", "OpenPBR Surface"]
exts."omni.rtx.window.settings".window_menu = "Window"
exts."omni.kit.viewport.menubar.lighting".defaultRigIgnorePattern = ""
exts."omni.kit.viewport.window".windowMenu.entryCount = 1
exts."omni.kit.viewport.window".windowMenu.label = ""
renderer.gpuEnumeration.glInterop.enabled = false
renderer.asyncInit = true
renderer.multiGpu.enabled = false
renderer.skipWhileMinimized = true
rtx.ecoMode.enabled = true
rtx.hydra.mdlMaterialWarmup = true
rtx.cudaInterop.enabled = false
rtx.pathtraced.maxSamples = 1
rtx.pathtraced.denoiserEnabled = false
telemetry.disableInternalSessionCheck = true
telemetry.enableAnonymousAppName = true
telemetry.enableAnonymousData = true
privacy.externalBuild = true


[settings.app]
content.emptyStageOnStart = true
font.file = "${fonts}/OpenSans-SemiBold.ttf"
font.size = 16
hangDetector.enabled = true
hangDetector.timeout = 120
renderer.skipWhileMinimized = false
window.title = "RAN Omniverse Server"
window.width = 1920
window.height = 1080
window.x = 0
window.y = 0


[settings.app.environment]
name = "RAN Omniverse Server"


[settings.app.exts]
# Our extensions live here (absolute path — decoupled from kit-app-template).
# omni.kit_app includes built-in extscache via pip installation
folders.'++' = [
    "/home/mitlab/XAPP_DT/Omnivers_platform/extensions",
]


[settings.app.viewport.defaults]
fillViewport = true
hydraEngine.name = "rtx"


# Kit SDK Version: 110.0.0
########################################################################################################################
# BEGIN GENERATED PART (copied from Omnivers_platform/kit/ran_server.kit — Kit 110.0.0)
########################################################################################################################

[settings.app.exts]
enabled = [
    "omni.anim.curve.core-1.6.0",
    "omni.convexdecomposition-110.0.6",
    "omni.graph.action-2.10.2",
    "omni.graph.action_nodes-2.10.3",
    "omni.graph.action_nodes_core-2.10.2",
    "omni.graph.nodes-2.11.1",
    "omni.graph.nodes_core-2.10.3",
    "omni.graph.scriptnode-2.10.2",
    "omni.graph.ui_nodes-2.10.5",
    "omni.kit.asset_converter-5.1.2",
    "omni.kit.debug.settings-1.0.3",
    "omni.kit.dev.utilities.bundle-0.2.1",
    "omni.kit.developer.bundle-0.2.0",
    "omni.kit.tool.asset_importer-5.1.4",
    "omni.kit.viewport.menubar.lighting-107.3.2",
    "omni.physx-110.0.6",
    "omni.physx.cooking-110.0.6",
    "omni.physx.foundation-110.0.6",
    "omni.physx.stageupdate-110.0.6",
    "omni.usd.metrics.assembler-110.0.0",
    "omni.usd.metrics.assembler.ui-110.0.0",
    "omni.usd.schema.metrics.assembler-110.0.0",
    "omni.usd.schema.physx-110.0.6",
    "omni.usdphysics-110.0.6",
    "omni.warp.core-1.12.0",
]

########################################################################################################################
# END GENERATED PART
########################################################################################################################
